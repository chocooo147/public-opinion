{
  "version": "1.3.0-workflow-v1.0-2026-08-12",
  "current_unified_entrypoint": "ops/production/weekly_pipeline.py",
  "required_policy": "config/weekly_production_policy.json",
  "required_workflow": "config/workflow_v1.json",
  "workflow": {
    "version": "apex-workflow-v1.0",
    "phases": ["prepare", "candidate", "publish"]
  },
  "command_registry": [
    {
      "path": "ops/production/weekly_pipeline.py",
      "classification": "current_production",
      "allowed_modes": ["production", "revision", "simulate"],
      "workflow_phases": ["prepare", "candidate", "publish", "full_simulation_only"],
      "publish_authority": true
    },
    {
      "path": "scripts/reconcile_weekly_status.py",
      "classification": "current_status_reconciler",
      "allowed_operations": ["reconcile_public_status"],
      "allowed_reads": [
        "current",
        "candidate",
        "manifests",
        "receipts",
        "latest_pipeline_state",
        "existing_public_status"
      ],
      "allowed_writes": ["weekly.json"],
      "publish_authority": false,
      "invocation_authority": "explicit_maintenance_invocation_only"
    },
    {
      "path": "scripts/workflow_checkpoint.py",
      "classification": "current_production_gate",
      "allowed_operations": ["create", "verify", "authorize"],
      "publish_authority": false
    },
    {
      "path": "scripts/production_preflight.py",
      "classification": "current_production_gate",
      "allowed_modes": ["production", "revision"],
      "publish_authority": false
    },
    {
      "path": "scripts/run_platform_collector.py",
      "classification": "current_stage_component",
      "allowed_modes": ["production", "revision"],
      "publish_authority": false
    },
    {
      "path": "scripts/publish_protected_site.py",
      "classification": "current_stage_component",
      "invocation_authority": "current_unified_entrypoint_only",
      "publish_authority": true
    },
    {
      "path": "archive/legacy_scripts/**",
      "classification": "historical_forbidden_by_default",
      "publish_authority": false
    }
  ],
  "stages_by_phase": {
    "prepare": [
      "production_preflight",
      "collect_bilibili",
      "collect_heybox",
      "prepare_release",
      "checkpoint_analyst_synthesis"
    ],
    "candidate": [
      "verify_analyst_checkpoint",
      "production_preflight",
      "build_report",
      "validate_release",
      "deploy_review_candidate",
      "verify_review_candidate",
      "send_internal_review_email",
      "checkpoint_human_approval"
    ],
    "publish": [
      "production_preflight",
      "authorize_release",
      "promote_candidate_to_live",
      "verify_live",
      "send_final_delivery_email"
    ],
    "full_simulation_only": [
      "collect_bilibili",
      "collect_heybox",
      "prepare_release",
      "build_report",
      "validate_release",
      "publish_site",
      "verify_live"
    ]
  },
  "legacy_or_one_off_not_for_production": [
    "scripts/build_public_opinion_mixed_test.py",
    "scripts/patch_w29_dashboard.py",
    "scripts/patch_w30_dashboard.py",
    "outputs/*/build_*.mjs"
  ],
  "stage_conditions": {
    "production_preflight": "required_for_each_production_or_revision phase; skipped_for simulation",
    "human_approval": "external human decision after review-candidate deployment; never generated by systemd",
    "custom_agents": "external Sol orchestration with runtime receipts; systemd does not spawn Custom Agents"
  },
  "rule": "Only current_unified_entrypoint may produce a publishable release manifest. Legacy and one-off scripts are retained for audit evidence and must not publish."
}
