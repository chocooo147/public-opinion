[Unit]
Description=APEX weekly machine preparation to human-approval checkpoint
After=network-online.target apex-app-auth.service
Wants=network-online.target apex-app-auth.service

[Service]
Type=oneshot
User=apex
Group=apex
WorkingDirectory=/opt/apex
EnvironmentFile=/opt/apex/runtime.env
EnvironmentFile=-/etc/apex/weekly.env
ExecStart=/opt/apex/venv-analysis/bin/python /opt/apex/ops/production/weekly_pipeline.py --workflow-phase prepare
TimeoutStartSec=8h30m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
PrivateTmp=true
NoNewPrivileges=true
