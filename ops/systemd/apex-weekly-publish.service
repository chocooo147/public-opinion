[Unit]
Description=APEX Workflow v1.0 promote approved Candidate to LIVE
After=network-online.target apex-app-auth.service
Wants=network-online.target apex-app-auth.service
[Service]
Type=oneshot
User=apex
Group=apex
WorkingDirectory=/opt/apex
EnvironmentFile=/opt/apex/runtime.env
EnvironmentFile=/etc/apex/publish.env
ExecStart=/opt/apex/venv-analysis/bin/python /opt/apex/ops/production/weekly_pipeline.py --workflow-phase publish --checkpoint ${APEX_CHECKPOINT} --agent-runtime-receipt ${APEX_AGENT_RUNTIME_RECEIPT} --approval ${APEX_APPROVAL}
TimeoutStartSec=30m
PrivateTmp=true
NoNewPrivileges=true
